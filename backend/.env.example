# Development only. scripts/run-local.sh loads this file; direct Maven/Java needs exported variables.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/yfc
DB_USER=yfc
DB_PASSWORD=replace-with-a-local-database-password
YFC_ADMIN_USERNAME=admin
# First database initialization only; existing passwords are never overwritten.
YFC_ADMIN_PASSWORD=replace-with-a-long-local-admin-password

# For IAM-enabled AWS databases, use DB_AUTH_MODE=iam and set AWS_REGION.
# DB_AUTH_MODE=password
# AWS_REGION=ap-south-2
# AWS_PROFILE=default
# DB_POOL_MAX_SIZE=5
